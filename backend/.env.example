DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Postgres (docker compose-той таарна). Хоосон бол sqlite ашиглана.
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Төлбөр: demo (анхдагч, мөнгө шилжихгүй) | qpay (гэрээ байгуулсны дараа хэрэгжүүлнэ)
PAYMENT_PROVIDER=demo
PLATFORM_FEE_PCT=10
# Дэлхийн мэдээ: Vercel Cron-ын нууц (Authorization: Bearer ...). 1212.mn API-г ҮСХ-ны зөвшөөрөл авсны дараа л асаана.
CRON_SECRET=
NSO_API_ENABLED=0
